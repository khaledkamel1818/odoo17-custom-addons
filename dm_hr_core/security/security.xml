<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_dm_hr_org_chart_user" model="res.groups">
            <field name="name">عرض الهيكل التنظيمي</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">يسمح بفتح شاشة الهيكل التنظيمي، مع تطبيق نطاق الرؤية من الخادم.</field>
        </record>

        <!-- Internal employee without HR privileges -->
        <record id="group_dm_hr_employee" model="res.groups">
            <field name="name">موظف</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_dm_hr_org_chart_user'))]"/>
            <field name="comment">موظف داخلي: يرى بيانات الموارد البشرية الخاصة به فقط.</field>
        </record>

        <!-- Line manager: team scope without full HR access -->
        <record id="group_dm_hr_line_manager" model="res.groups">
            <field name="name">مدير مباشر</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_employee'))]"/>
            <field name="comment">مدير مباشر: يتابع طلبات وحضور فريقه ويعتمد ما يسند إليه بدون صلاحيات موارد بشرية كاملة.</field>
        </record>

        <!-- Functional HR roles -->
        <record id="group_dm_hr_leave_officer" model="res.groups">
            <field name="name">مسؤول الإجازات</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_employee')), (4, ref('hr_holidays.group_hr_holidays_user'))]"/>
            <field name="comment">مسؤول الإجازات: إدارة ومتابعة طلبات وأرصدة الإجازات ضمن الشركات المسموح بها.</field>
        </record>

        <record id="group_dm_hr_attendance_officer" model="res.groups">
            <field name="name">مسؤول الحضور والانصراف</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_employee')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
            <field name="comment">مسؤول الحضور والانصراف: متابعة السجلات والتصحيحات وأسباب الحضور ضمن الشركات المسموح بها.</field>
        </record>

        <record id="group_dm_hr_document_officer" model="res.groups">
            <field name="name">مسؤول وثائق الموظفين</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_employee')), (4, ref('hr.group_hr_user'))]"/>
            <field name="comment">مسؤول وثائق الموظفين: إدارة المستندات والمرافقين والتأمينات الطبية للموظفين.</field>
        </record>

        <!-- HR Officer (O17: resource management granted via hr.group_hr_user) -->
        <record id="group_dm_hr_officer" model="res.groups">
            <field name="name">مسؤول الموارد البشرية</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_document_officer')), (4, ref('group_dm_hr_leave_officer')), (4, ref('group_dm_hr_attendance_officer')), (4, ref('hr.group_hr_user')), (4, ref('hr_holidays.group_hr_holidays_user')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
            <field name="comment">مسؤول الموارد البشرية: يدير سجلات الموارد البشرية للشركات المسموح بها.</field>
        </record>

        <!-- HR Manager -->
        <record id="group_dm_hr_manager" model="res.groups">
            <field name="name">مدير الموارد البشرية</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_officer')), (4, ref('hr.group_hr_manager')), (4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
            <field name="comment">مدير الموارد البشرية: الاعتمادات النهائية وإعدادات الموارد البشرية.</field>
        </record>

        <!-- Payroll officer (computation, no accounting) -->
        <record id="group_dm_payroll_officer" model="res.groups">
            <field name="name">مسؤول الرواتب</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_employee'))]"/>
            <field name="comment">مسؤول الرواتب: يقرأ بيانات الرواتب ويحتسب مسيرات الرواتب.</field>
        </record>

        <!-- Payroll manager -->
        <record id="group_dm_payroll_manager" model="res.groups">
            <field name="name">مدير الرواتب</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_payroll_officer')), (4, ref('group_dm_hr_manager'))]"/>
            <field name="comment">مدير الرواتب: يراجع الرواتب ويعتمدها نهائياً.</field>
        </record>

        <!-- HR Admin: top configuration, explicitly NOT implied any accounting group -->
        <record id="group_dm_hr_admin" model="res.groups">
            <field name="name">مشرف الموارد البشرية</field>
            <field name="category_id" ref="base.module_category_human_resources_employees"/>
            <field name="implied_ids" eval="[(4, ref('group_dm_hr_manager')), (4, ref('group_dm_payroll_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">صلاحية كاملة لإعدادات الموارد البشرية، ولا ترث أي مجموعة محاسبية.</field>
        </record>
    </data>
</odoo>
