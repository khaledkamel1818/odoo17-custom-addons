        <record id="service_type_permission" model="dm.hr.service.request.type">
            <field name="name">استئذان</field>
            <field name="code">permission</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">10</field>
            <field name="requires_dates">True</field>
            <field name="requires_permission_validation">True</field>
            <field name="monthly_limit_hours">12.0</field>
            <field name="yearly_limit_hours">120.0</field>
        </record>
        <record id="service_type_remote_work" model="dm.hr.service.request.type">
            <field name="name">عمل عن بعد</field>
            <field name="code">remote_work</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">20</field>
            <field name="requires_dates">True</field>
        </record>
        <record id="service_type_salary_certificate" model="dm.hr.service.request.type">
            <field name="name">خطاب تعريف بالراتب</field>
            <field name="code">salary_certificate</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">30</field>
            <field name="report_action_xmlid">dm_hr_core.action_report_dm_hr_salary_certificate</field>
        </record>
        <record id="service_type_salary_transfer" model="dm.hr.service.request.type">
