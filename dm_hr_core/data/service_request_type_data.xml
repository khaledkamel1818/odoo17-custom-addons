        <record id="service_type_document_update" model="dm.hr.service.request.type">
            <field name="name">تحديث بيانات أو مستندات</field>
            <field name="code">document_update</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">60</field>
        </record>
        <record id="service_type_overtime" model="dm.hr.service.request.type">
            <field name="name">طلب ساعات إضافية</field>
