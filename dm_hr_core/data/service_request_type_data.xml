            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">70</field>
            <field name="requires_dates">True</field>
        </record>
        <record id="service_type_business_trip" model="dm.hr.service.request.type">
            <field name="name">انتداب / مهمة عمل</field>
            <field name="code">business_trip</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">80</field>
            <field name="requires_dates">True</field>
            <field name="requires_trip_details">True</field>
        </record>
        <record id="service_type_equipment" model="dm.hr.service.request.type">
            <field name="name">أدوات أو عهدة</field>
            <field name="code">equipment</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">90</field>
        </record>
        <record id="service_type_other" model="dm.hr.service.request.type">
            <field name="name">طلب آخر</field>
            <field name="code">other</field>
            <field name="company_id" ref="base.main_company"/>
