            <field name="name">الموارد البشرية: تصحيح حضور</field>
            <field name="code">dm.hr.attendance.correction</field>
            <field name="prefix">ATTC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
