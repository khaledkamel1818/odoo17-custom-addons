        </record>
        <record id="seq_leave_purchase" model="ir.sequence">
            <field name="name">الموارد البشرية: شراء إجازة</field>
            <field name="code">dm.hr.leave.purchase</field>
            <field name="prefix">LVP-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_leave_balance_request" model="ir.sequence">
            <field name="name">الموارد البشرية: طلب إضافة رصيد إجازة</field>
            <field name="code">dm.hr.leave.balance.request</field>
            <field name="prefix">LVB-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_employee_financial_request" model="ir.sequence">
            <field name="name">الموارد البشرية: طلب مالي للموظف</field>
            <field name="code">dm.hr.employee.financial.request</field>
