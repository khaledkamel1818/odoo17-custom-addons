<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Company-scoped employee number sequence (per company, prefixed). -->
        <record id="seq_employee_number" model="ir.sequence">
            <field name="name">الموارد البشرية: الرقم الوظيفي</field>
            <field name="code">dm.hr.employee.number</field>
            <field name="prefix">EMP-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_service_request" model="ir.sequence">
            <field name="name">الموارد البشرية: طلب خدمة موظف</field>
            <field name="code">dm.hr.service.request</field>
            <field name="prefix">HRREQ-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_service_letter" model="ir.sequence">
            <field name="name">الموارد البشرية: مرجع خطابات الخدمات</field>
            <field name="code">dm.hr.service.letter</field>
            <field name="prefix">HRLTR-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_probation_extension" model="ir.sequence">
            <field name="name">الموارد البشرية: تمديد فترة التجربة</field>
            <field name="code">dm.hr.probation.extension</field>
            <field name="prefix">PROB-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_document_renewal" model="ir.sequence">
            <field name="name">الموارد البشرية: تجديد وثيقة</field>
            <field name="code">dm.hr.document.renewal</field>
            <field name="prefix">REN-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_manpower_request" model="ir.sequence">
            <field name="name">الموارد البشرية: طلب احتياج وظيفي</field>
            <field name="code">dm.hr.manpower.request</field>
            <field name="prefix">JOBREQ-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_return_to_work" model="ir.sequence">
            <field name="name">الموارد البشرية: مباشرة العمل</field>
            <field name="code">dm.hr.return.work</field>
            <field name="prefix">RTW-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_transfer" model="ir.sequence">
            <field name="name">الموارد البشرية: نقل وتغيير وظيفة</field>
            <field name="code">dm.hr.employee.transfer</field>
            <field name="prefix">TRN-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_custody" model="ir.sequence">
            <field name="name">الموارد البشرية: عهدة غير مالية</field>
            <field name="code">dm.hr.custody</field>
            <field name="prefix">CST-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_leave_action" model="ir.sequence">
            <field name="name">الموارد البشرية: إجراء إجازة</field>
            <field name="code">dm.hr.leave.action</field>
