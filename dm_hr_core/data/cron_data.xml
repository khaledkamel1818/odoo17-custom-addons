<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Weekly expiry-alert cron (runs Monday 06:00). Safe on Community. -->
        <record id="cron_dm_hr_expiry_alerts" model="ir.cron">
            <field name="name">الموارد البشرية: تنبيهات الانتهاء</field>
            <field name="model_id" ref="model_dm_hr_expiry_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_run()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_dm_hr_overdue_approval_escalation" model="ir.cron">
            <field name="name">الموارد البشرية: تصعيد الموافقات المتأخرة</field>
            <field name="model_id" ref="model_dm_hr_service_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_escalate_overdue_approvals()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
