<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dm_hr_branch_view_tree" model="ir.ui.view">
        <field name="name">dm.hr.branch.tree</field>
        <field name="model">dm.hr.branch</field>
        <field name="arch" type="xml">
            <tree string="فروع الشركة" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="city"/>
                <field name="manager_id"/>
                <field name="employee_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="dm_hr_branch_view_form" model="ir.ui.view">
        <field name="name">dm.hr.branch.form</field>
        <field name="model">dm.hr.branch</field>
        <field name="arch" type="xml">
            <form string="فرع الشركة">
                <sheet>
                    <div class="dm_hr_form_hero">
                        <div>
                            <label for="name" string="اسم الفرع"/>
                            <h1><field name="name" placeholder="مثال: فرع الرياض"/></h1>
                        </div>
                        <span class="dm_hr_title_badge">Branch</span>
                    </div>
                    <group>
                        <group string="بيانات الفرع">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="city"/>
                            <field name="address"/>
                        </group>
                        <group string="الإدارة">
                            <field name="manager_id"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="employee_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dm_hr_branch_action" model="ir.actions.act_window">
        <field name="name">الفروع</field>
        <field name="res_model">dm.hr.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="dm_hr_org_chart_client_action" model="ir.actions.client">
        <field name="name">الهيكل التنظيمي</field>
        <field name="tag">dm_hr_core.org_chart_action</field>
    </record>

    <menuitem id="menu_dm_hr_org_chart_root"
              name="الهيكل التنظيمي"
              parent="menu_dm_hr_root"
              action="dm_hr_org_chart_client_action"
              sequence="12"
              groups="dm_hr_core.group_dm_hr_org_chart_user"/>

    <record id="hr_department_form_dm_approval" model="ir.ui.view">
        <field name="name">hr.department.form.dm.approval</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="dm_hr_panel">
                    <div class="dm_hr_title_line">
                        <i class="fa fa-sitemap" title="الهيكل والموافقات"/>
                        <h3>الهيكل والموافقات</h3>
                        <span class="dm_hr_title_badge">Approval</span>
                    </div>
                    <group>
                        <field name="dm_org_level"/>
                        <field name="parent_id"/>
                        <field name="dm_branch_id"/>
                        <field name="dm_approval_manager_id"/>
                        <field name="dm_approval_level"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_job_form_dm_approval" model="ir.ui.view">
        <field name="name">hr.job.form.dm.approval</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="dm_hr_panel">
                    <div class="dm_hr_title_line">
                        <i class="fa fa-check-square-o" title="دور الموافقات"/>
                        <h3>دور الوظيفة في الموافقات</h3>
                    </div>
                    <group>
                        <field name="dm_approval_role"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_dm_hr_structure_approvals"
              name="الهيكل والموافقات"
              parent="menu_dm_hr_configuration"
              sequence="4"
              groups="dm_hr_core.group_dm_hr_manager,dm_hr_core.group_dm_hr_admin"/>
    <menuitem id="menu_dm_hr_structure_branches"
              name="الفروع"
              parent="menu_dm_hr_structure_approvals"
              action="dm_hr_branch_action"
              sequence="5"
              groups="dm_hr_core.group_dm_hr_manager,dm_hr_core.group_dm_hr_admin"/>
    <menuitem id="menu_dm_hr_structure_departments"
              name="القطاعات والإدارات والأقسام"
              parent="menu_dm_hr_structure_approvals"
              action="hr.hr_department_tree_action"
              sequence="10"
              groups="dm_hr_core.group_dm_hr_manager,dm_hr_core.group_dm_hr_admin"/>
    <menuitem id="menu_dm_hr_structure_jobs"
              name="المناصب والوظائف"
              parent="menu_dm_hr_structure_approvals"
              action="hr.action_hr_job"
              sequence="20"
              groups="dm_hr_core.group_dm_hr_manager,dm_hr_core.group_dm_hr_admin"/>
    <menuitem id="menu_dm_hr_structure_policies"
              name="سلاسل الموافقات"
              parent="menu_dm_hr_structure_approvals"
              action="dm_hr_approval_policy_action"
              sequence="30"
              groups="dm_hr_core.group_dm_hr_manager,dm_hr_core.group_dm_hr_admin"/>
</odoo>
