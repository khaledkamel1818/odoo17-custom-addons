#. module: dm_hr_core
msgid "The employee number must be unique within the company."
msgstr "يجب أن يكون الرقم الوظيفي فريداً داخل الشركة."

#. module: dm_hr_core
msgid "The Iqama / National ID '%s' is already used by another employee in this company."
msgstr "الإقامة / الهوية الوطنية '%s' مستخدمة بالفعل لموظف آخر في هذه الشركة."

#. module: dm_hr_core
msgid "The allowance type code is required."
msgstr "رمز نوع البدل مطلوب."

#. module: dm_hr_core
msgid "The allowance start date must not be after its end date."
msgstr "يجب ألا يكون تاريخ بداية البدل بعد تاريخ نهايته."

#. module: dm_hr_core
msgid "Two allowances of the same type cannot overlap for the same employee."
msgstr "لا يمكن تداخل بدلَين من نفس النوع للموظف نفسه."

#. module: dm_hr_core
msgid "Two allowances of the same type cannot overlap on the same contract."
msgstr "لا يمكن تداخل بدلَين من نفس النوع على العقد نفسه."

#. module: dm_hr_core
msgid "A fixed allowance requires an amount greater than zero."
msgstr "البدل الثابت يتطلب مبلغاً أكبر من صفر."

#. module: dm_hr_core
msgid "Percentage allowances require a percent strictly between 0 and 100."
msgstr "البدلات النسبية تتطلب نسبة أكبر من 0 وأقل أو تساوي 100."

#. module: dm_hr_core
msgid "A percentage-of-component allowance requires another allowance type as its base."
msgstr "البدل المحتسب كنسبة من مكون يتطلب نوع بدل آخر كأساس."

#. module: dm_hr_core
msgid "An allowance cannot be a percentage of its own type."
msgstr "لا يمكن أن يكون البدل نسبة من نفس نوعه."

#. module: dm_hr_core
msgid "Insurance share percentages must be between 0 and 100."
msgstr "يجب أن تكون نسب التأمين بين 0 و100."

#. module: dm_hr_core
msgid "The policy start date must not be after its end date."
msgstr "يجب ألا يكون تاريخ بداية الوثيقة بعد تاريخ نهايتها."

#. module: dm_hr_core
msgid "Two policies of the same provider cannot overlap for the same employee."
msgstr "لا يمكن تداخل وثيقتين من المزود نفسه للموظف نفسه."

#. module: dm_hr_core
msgid "The scheme code is required."
msgstr "رمز النظام مطلوب."

#. module: dm_hr_core
msgid "Social insurance ratios must be between 0 and 100."
msgstr "يجب أن تكون نسب التأمينات الاجتماعية بين 0 و100."

#. module: dm_hr_core
msgid "The effective-from date must not be after the effective-to date."
msgstr "يجب ألا يكون تاريخ بداية السريان بعد تاريخ نهايته."

#. module: dm_hr_core
msgid "Social insurance rates for the same scheme, category and company cannot have overlapping effective periods."
msgstr "لا يمكن تداخل نسب التأمينات للنظام والفئة والشركة نفسها في فترات سريان متداخلة."

#. module: dm_hr_core
msgid "The probation end date must not be before the contract start date."
msgstr "يجب ألا يكون تاريخ انتهاء فترة التجربة قبل تاريخ بداية العقد."

