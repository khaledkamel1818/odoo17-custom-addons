<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dm_finance_voucher_view_tree" model="ir.ui.view">
        <field name="name">dm.finance.voucher.tree</field>
        <field name="model">dm.finance.voucher</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'under_approval'" decoration-success="state == 'approved'" decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="date"/>
                <field name="voucher_type"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <field name="journal_id"/>
                <field name="amount_total" sum="الإجمالي"/>
                <field name="currency_id" optional="hide"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="dm_finance_voucher_view_form" model="ir.ui.view">
        <field name="name">dm.finance.voucher.form</field>
        <field name="model">dm.finance.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="إرسال للاعتماد" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_post" type="object" string="ترحيل" class="btn-primary" invisible="state != 'approved'" groups="dm_finance_core.group_finance_general_accountant,dm_finance_core.group_finance_manager,dm_finance_core.group_finance_admin"/>
                    <button name="action_reset_to_draft" type="object" string="إرجاع إلى مسودة" invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('posted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_approval,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="voucher_type" readonly="state not in ('draft', 'rejected')"/>
                            <field name="date" readonly="state not in ('draft', 'rejected')"/>
                            <field name="company_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="currency_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="branch_id" readonly="state not in ('draft', 'rejected')"/>
                        </group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="journal_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="destination_journal_id" readonly="state not in ('draft', 'rejected')" invisible="voucher_type != 'transfer'"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بنود السند">
                            <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="amount" sum="الإجمالي"/>
                                    <field name="currency_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="تفاصيل الدفع">
                            <group>
                                <field name="payment_reference" readonly="state not in ('draft', 'rejected')"/>
                                <field name="cheque_number" readonly="state not in ('draft', 'rejected')"/>
                                <field name="cheque_date" readonly="state not in ('draft', 'rejected')"/>
                                <field name="bank_reference" readonly="state not in ('draft', 'rejected')"/>
                            </group>
                        </page>
                        <page string="الروابط المحاسبية">
                            <group>
                                <field name="move_id" readonly="1"/>
                                <field name="payment_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="البيان">
                            <field name="narration" readonly="state not in ('draft', 'rejected')" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="dm_finance_voucher_view_search" model="ir.ui.view">
        <field name="name">dm.finance.voucher.search</field>
        <field name="model">dm.finance.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <field name="journal_id"/>
                <filter name="draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="under_approval" string="قيد الاعتماد" domain="[('state', '=', 'under_approval')]"/>
                <filter name="approved" string="معتمد" domain="[('state', '=', 'approved')]"/>
                <filter name="receipt" string="سندات قبض" domain="[('voucher_type', '=', 'receipt')]"/>
                <filter name="payment" string="سندات صرف" domain="[('voucher_type', '=', 'payment')]"/>
                <filter name="transfer" string="سندات تحويل" domain="[('voucher_type', '=', 'transfer')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_voucher_type" string="نوع السند" context="{'group_by': 'voucher_type'}"/>
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="الفرع المالي" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_journal" string="دفتر اليومية" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dm_finance_voucher_action" model="ir.actions.act_window">
        <field name="name">السندات المالية</field>
        <field name="res_model">dm.finance.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أنشئ أول سند مالي</p>
            <p>استخدم السندات لضبط طلبات القبض والصرف والتحويل قبل الترحيل المحاسبي.</p>
        </field>
    </record>
</odoo>
