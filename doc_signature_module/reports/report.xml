<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper Format: A4 with margins -->
        <record id="paperformat_signature_doc" model="report.paperformat">
            <field name="name">Signature Doc A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Report Action -->
        <record id="action_report_signature_document" model="ir.actions.report">
            <field name="name">Print Signed PDF</field>
            <field name="model">signature.document</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">doc_signature_module.report_signature_document_template</field>
            <field name="report_file">doc_signature_module.report_signature_document_template</field>
            <field name="paperformat_id" ref="paperformat_signature_doc"/>
            <field name="binding_model_id" ref="model_signature_document"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
