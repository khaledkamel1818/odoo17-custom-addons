<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dm_finance_branch_view_tree" model="ir.ui.view">
        <field name="name">dm.finance.branch.tree</field>
        <field name="model">dm.finance.branch</field>
        <field name="arch" type="xml">
            <tree string="الفروع المالية">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="manager_id"/>
                <field name="analytic_account_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="dm_finance_branch_view_form" model="ir.ui.view">
        <field name="name">dm.finance.branch.form</field>
        <field name="model">dm.finance.branch</field>
        <field name="arch" type="xml">
            <form string="فرع مالي">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="اسم الفرع"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                    <group string="العنوان">
                        <field name="street"/>
                        <field name="city"/>
                        <field name="country_id"/>
                    </group>
                    <notebook>
                        <page string="ملاحظات" name="notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dm_finance_branch_view_search" model="ir.ui.view">
        <field name="name">dm.finance.branch.search</field>
        <field name="model">dm.finance.branch</field>
        <field name="arch" type="xml">
            <search string="الفروع المالية">
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter name="active" string="نشط" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="مؤرشف" domain="[('active', '=', False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}"/>
                    <filter name="group_manager" string="المدير" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dm_finance_branch_action" model="ir.actions.act_window">
        <field name="name">الفروع المالية</field>
        <field name="res_model">dm.finance.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
