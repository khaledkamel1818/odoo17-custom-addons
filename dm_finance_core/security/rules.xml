        <record id="dm_finance_branch_multi_company_rule" model="ir.rule">
            <field name="name">Finance branches: allowed companies</field>
            <field name="model_id" ref="model_dm_finance_branch"/>
            <field name="groups" eval="[(4, ref('group_finance_requester')), (4, ref('group_finance_auditor')), (4, ref('group_finance_manager')), (4, ref('group_finance_admin'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

