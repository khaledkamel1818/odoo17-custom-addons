<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_finance_requester" model="res.groups">
            <field name="name">Finance Requester</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can create and follow own finance requests.</field>
        </record>

        <record id="group_finance_custodian" model="res.groups">
            <field name="name">Finance Custodian</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_requester'))]"/>
        </record>

        <record id="group_finance_cashier" model="res.groups">
            <field name="name">Finance Cashier</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_requester'))]"/>
        </record>

        <record id="group_finance_ar_accountant" model="res.groups">
            <field name="name">AR Accountant</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_requester'))]"/>
        </record>

        <record id="group_finance_ap_accountant" model="res.groups">
            <field name="name">AP Accountant</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_requester'))]"/>
        </record>

        <record id="group_finance_treasury_accountant" model="res.groups">
            <field name="name">Treasury Accountant</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_requester'))]"/>
        </record>

        <record id="group_finance_general_accountant" model="res.groups">
            <field name="name">General Accountant</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_ar_accountant')), (4, ref('group_finance_ap_accountant')), (4, ref('group_finance_treasury_accountant'))]"/>
        </record>

        <record id="group_finance_branch_supervisor" model="res.groups">
            <field name="name">Branch Finance Supervisor</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_general_accountant'))]"/>
        </record>

        <record id="group_finance_manager" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_branch_supervisor'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_finance_auditor" model="res.groups">
            <field name="name">Finance Auditor / Read Only</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_finance_admin" model="res.groups">
            <field name="name">Finance Administrator</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
