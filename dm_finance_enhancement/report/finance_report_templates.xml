<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_dm_finance_report" model="report.paperformat">
        <field name="name">DM Finance Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_dm_finance_dynamic" model="ir.actions.report">
        <field name="name">Finance Dynamic Report</field>
        <field name="model">dm.finance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dm_finance_enhancement.report_dm_finance_dynamic</field>
        <field name="report_file">dm_finance_enhancement.report_dm_finance_dynamic</field>
        <field name="paperformat_id" ref="paperformat_dm_finance_report"/>
        <field name="binding_model_id" ref="model_dm_finance_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dm_finance_dynamic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="lines" t-value="doc.line_ids"/>
                <div class="page"
                     t-att-dir="'rtl' if (doc.env.context.get('lang') or '').startswith('ar') else 'ltr'"
                     t-att-style="'direction: rtl; text-align: right; font-family: DejaVu Sans, Arial, sans-serif;' if (doc.env.context.get('lang') or '').startswith('ar') else 'direction: ltr; text-align: left; font-family: DejaVu Sans, Arial, sans-serif;'">
                    <div style="border-radius: 14px; background: linear-gradient(135deg, #0f766e, #164e63); color: white; padding: 22px;">
                        <h2 style="margin: 0;">
                            <span t-esc="dict(doc._fields['report_type'].selection).get(doc.report_type)"/>
                        </h2>
                        <p style="margin: 6px 0 0 0;">
                            <span t-esc="doc.company_id.name"/>
                            |
                            <span t-esc="doc.date_from"/>
                            -
                            <span t-esc="doc.date_to"/>
                        </p>
                    </div>

                    <table style="width: 100%; margin-top: 18px; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #eaf4f1;">
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: start;">Name</th>
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: start;">Account</th>
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: start;">Partner</th>
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: right;">Debit</th>
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: right;">Credit</th>
                                <th style="padding: 8px; border: 1px solid #d8e7e3; text-align: right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="line">
                                <td style="padding: 7px; border: 1px solid #edf2f7;"><span t-esc="line.name"/></td>
                                <td style="padding: 7px; border: 1px solid #edf2f7;"><span t-esc="line.account_id.display_name if line.account_id else ''"/></td>
                                <td style="padding: 7px; border: 1px solid #edf2f7;"><span t-esc="line.partner_id.display_name if line.partner_id else ''"/></td>
                                <td style="padding: 7px; border: 1px solid #edf2f7; text-align: right;"><span t-esc="'{:,.2f}'.format(line.debit or 0.0)"/></td>
                                <td style="padding: 7px; border: 1px solid #edf2f7; text-align: right;"><span t-esc="'{:,.2f}'.format(line.credit or 0.0)"/></td>
                                <td style="padding: 7px; border: 1px solid #edf2f7; text-align: right;"><span t-esc="'{:,.2f}'.format(line.balance or 0.0)"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="margin-top: 18px; color: #64748b; font-size: 11px;">
                        Generated by DM Finance Enhancement. Tax and zakat calculations must be reviewed against configured Odoo taxes and current regulations.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
