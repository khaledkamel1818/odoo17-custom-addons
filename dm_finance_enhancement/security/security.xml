<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_dm_finance_enhancement" model="ir.module.category">
            <field name="name">DM Finance Enhancement</field>
            <field name="description">Professional finance roles</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_finance_user" model="res.groups">
            <field name="name">Finance User</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly')), (4, ref('dm_finance_core.group_finance_requester'))]"/>
        </record>

        <record id="group_bank_reconciliation_officer" model="res.groups">
            <field name="name">Bank Reconciliation Officer</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_user'))]"/>
        </record>

        <record id="group_asset_accountant" model="res.groups">
            <field name="name">Asset Accountant</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_user'))]"/>
        </record>

        <record id="group_tax_manager" model="res.groups">
            <field name="name">Tax Manager</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[(4, ref('group_finance_user'))]"/>
        </record>

        <record id="group_auditor_readonly" model="res.groups">
            <field name="name">Auditor Read Only</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly')), (4, ref('dm_finance_core.group_finance_auditor'))]"/>
        </record>

        <record id="group_finance_manager" model="res.groups">
            <field name="name">Finance Manager</field>
            <field name="category_id" ref="module_category_dm_finance_enhancement"/>
            <field name="implied_ids" eval="[
                (4, ref('group_finance_user')),
                (4, ref('group_tax_manager')),
                (4, ref('group_bank_reconciliation_officer')),
                (4, ref('group_asset_accountant')),
                (4, ref('dm_finance_core.group_finance_manager')),
                (4, ref('account.group_account_manager'))
            ]"/>
        </record>
    </data>
</odoo>
