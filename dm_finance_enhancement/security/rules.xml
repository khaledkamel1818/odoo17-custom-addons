            <field name="groups" eval="[(4, ref('group_finance_user')), (4, ref('group_bank_reconciliation_officer')), (4, ref('group_finance_manager')), (4, ref('group_auditor_readonly'))]"/>
        </record>

        <record id="rule_dm_finance_annual_closing_company" model="ir.rule">
            <field name="name">Annual closing multi-company</field>
            <field name="model_id" ref="model_dm_finance_annual_closing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_finance_user')), (4, ref('group_finance_manager')), (4, ref('group_auditor_readonly'))]"/>
        </record>

        <record id="rule_dm_finance_audit_log_company" model="ir.rule">
            <field name="name">Finance audit log multi-company</field>
            <field name="model_id" ref="model_dm_finance_audit_log"/>
