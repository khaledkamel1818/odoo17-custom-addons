<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_dm_finance_bank_reconciliation_company" model="ir.rule">
            <field name="name">Bank reconciliation multi-company</field>
            <field name="model_id" ref="model_dm_finance_bank_reconciliation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_finance_user')), (4, ref('group_bank_reconciliation_officer')), (4, ref('group_finance_manager')), (4, ref('group_auditor_readonly'))]"/>
        </record>

        <record id="rule_dm_finance_bank_reconciliation_line_company" model="ir.rule">
            <field name="name">Bank reconciliation lines multi-company</field>
            <field name="model_id" ref="model_dm_finance_bank_reconciliation_line"/>
