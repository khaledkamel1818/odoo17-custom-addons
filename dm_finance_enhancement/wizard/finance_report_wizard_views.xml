<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dm_finance_report_wizard_view_form" model="ir.ui.view">
        <field name="name">dm.finance.report.wizard.form</field>
        <field name="model">dm.finance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Dynamic Finance Report">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Use the filters below to generate executive PDF and Excel reports. Tax and zakat rates remain configurable in settings.
                    </div>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="analytic_account_id"/>
                            <field name="hide_zero"/>
                        </group>
                    </group>
                    <group string="Comparison">
                        <field name="comparison_date_from"/>
                        <field name="comparison_date_to"/>
                    </group>
                    <notebook>
                        <page string="Preview">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="debit" sum="Debit"/>
                                    <field name="credit" sum="Credit"/>
                                    <field name="balance" sum="Balance"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                    <button name="action_print_pdf" string="Export PDF" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" class="btn-success"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dm_finance_report_trial_balance" model="ir.actions.act_window">
        <field name="name">Trial Balance</field>
        <field name="res_model">dm.finance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dm_finance_report_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'trial_balance'}</field>
    </record>

