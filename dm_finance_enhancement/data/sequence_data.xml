<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_dm_finance_bank_reconciliation" model="ir.sequence">
        <field name="name">Bank Reconciliation</field>
        <field name="code">dm.finance.bank.reconciliation</field>
        <field name="prefix">BR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_dm_finance_annual_closing" model="ir.sequence">
        <field name="name">Annual Closing</field>
        <field name="code">dm.finance.annual.closing</field>
        <field name="prefix">CL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

