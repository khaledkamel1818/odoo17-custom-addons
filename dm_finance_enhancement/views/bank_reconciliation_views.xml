<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dm_finance_bank_reconciliation_view_kanban" model="ir.ui.view">
        <field name="name">dm.finance.bank.reconciliation.kanban</field>
        <field name="model">dm.finance.bank.reconciliation</field>
        <field name="arch" type="xml">
            <kanban class="o_dm_finance_kanban">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="line_count"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_dm_finance_card">
                            <div class="o_dm_finance_card_head">
                                <strong><field name="name"/></strong>
                                <span class="badge rounded-pill text-bg-info"><field name="state"/></span>
                            </div>
                            <div class="text-muted"><field name="journal_id"/></div>
                            <div class="o_dm_finance_metric_row">
                                <span>Lines: <field name="line_count"/></span>
                                <span>Matched: <field name="matched_count"/></span>
                                <span>Open: <field name="unmatched_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dm_finance_bank_reconciliation_view_list" model="ir.ui.view">
        <field name="name">dm.finance.bank.reconciliation.list</field>
        <field name="model">dm.finance.bank.reconciliation</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'confirmed'" decoration-info="state == 'matching'">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="branch_id"/>
                <field name="line_count"/>
                <field name="matched_count"/>
                <field name="unmatched_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="dm_finance_bank_reconciliation_view_form" model="ir.ui.view">
        <field name="name">dm.finance.bank.reconciliation.form</field>
        <field name="model">dm.finance.bank.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation">
                <header>
                    <button name="action_import_statement" string="Import Statement" type="object" class="btn-primary"/>
                    <button name="action_auto_match" string="Auto Match" type="object" class="btn-secondary"/>
                    <button name="action_confirm_match" string="Confirm Match" type="object" class="btn-success"/>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,imported,matching,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle">
                            <field name="matched_count" widget="statinfo" string="Matched"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="unmatched_count" widget="statinfo" string="Open"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="journal_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="import_file" filename="import_filename"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement Lines">
                            <field name="line_ids">
                                <tree editable="bottom" decoration-success="state == 'matched'" decoration-warning="state == 'suggested'" decoration-muted="state == 'ignored'">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="reference"/>
                                    <field name="partner_name"/>
                                    <field name="memo"/>
                                    <field name="suggested_move_line_id"/>
                                    <field name="match_score"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_mark_matched" string="Match" type="object" icon="fa-check"/>
                                    <button name="action_ignore" string="Ignore" type="object" icon="fa-ban"/>
                                    <button name="action_reset" string="Reset" type="object" icon="fa-undo"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="dm_finance_bank_reconciliation_view_search" model="ir.ui.view">
        <field name="name">dm.finance.bank.reconciliation.search</field>
        <field name="model">dm.finance.bank.reconciliation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="branch_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="open" string="Open" domain="[('state','in',('imported','matching'))]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_journal" string="Journal" context="{'group_by':'journal_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dm_finance_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">dm.finance.bank.reconciliation</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="dm_finance_bank_reconciliation_view_search"/>
    </record>
</odoo>
