<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dm_hr_offboarding" model="ir.sequence">
            <field name="name">DM HR Offboarding</field>
            <field name="code">dm.hr.offboarding</field>
            <field name="prefix">OFF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dm_hr_offboarding_settlement" model="ir.sequence">
            <field name="name">DM HR Final Settlement</field>
            <field name="code">dm.hr.offboarding.settlement</field>
            <field name="prefix">EOS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dm_hr_exit_interview" model="ir.sequence">
            <field name="name">DM HR Exit Interview</field>
            <field name="code">dm.hr.exit.interview</field>
            <field name="prefix">EXIT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
