<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_dm_hr_offboarding_employee_own" model="ir.rule">
            <field name="name">Offboarding: employee own requests</field>
            <field name="model_id" ref="model_dm_hr_offboarding"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_employee'))]"/>
        </record>
        <record id="rule_dm_hr_offboarding_manager_team" model="ir.rule">
            <field name="name">Offboarding: manager team</field>
            <field name="model_id" ref="model_dm_hr_offboarding"/>
            <field name="domain_force">['|', ('manager_user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_manager'))]"/>
        </record>
        <record id="rule_dm_hr_offboarding_hr_company" model="ir.rule">
            <field name="name">Offboarding: HR allowed companies</field>
            <field name="model_id" ref="model_dm_hr_offboarding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_hr_officer')), (4, ref('group_dm_hr_offboarding_hr_manager')), (4, ref('group_dm_hr_offboarding_admin'))]"/>
        </record>
        <record id="rule_dm_hr_offboarding_settlement_finance_company" model="ir.rule">
            <field name="name">Offboarding settlement: finance/hr companies</field>
            <field name="model_id" ref="model_dm_hr_offboarding_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_finance_officer')), (4, ref('group_dm_hr_offboarding_finance_manager')), (4, ref('group_dm_hr_offboarding_hr_manager'))]"/>
        </record>
        <record id="rule_dm_hr_exit_interview_employee_own" model="ir.rule">
            <field name="name">Exit interview: employee own</field>
            <field name="model_id" ref="model_dm_hr_exit_interview"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_employee'))]"/>
        </record>
        <record id="rule_dm_hr_exit_interview_hr_company" model="ir.rule">
            <field name="name">Exit interview: HR companies</field>
            <field name="model_id" ref="model_dm_hr_exit_interview"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dm_hr_offboarding_hr_officer')), (4, ref('group_dm_hr_offboarding_hr_manager'))]"/>
        </record>
    </data>
</odoo>
